# Contraseña para entrar a tu oficina (elige una larga)
APP_PASSWORD=cambia-esta-contraseña
# Secreto para firmar la sesión: cualquier texto aleatorio de 32+ caracteres
# (genera uno con: openssl rand -base64 32)
AUTH_SECRET=pon-aqui-un-texto-aleatorio-largo
# Base de datos Postgres gratis (Neon). Si no se define, se guarda en ./data (solo para uso local)
DATABASE_URL=
